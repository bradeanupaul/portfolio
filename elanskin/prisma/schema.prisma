generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Order {
  id         String      @id @default(cuid())
  code       String      @unique
  fullName   String
  email      String
  phone      String
  county     String
  city       String
  address    String
  postalCode String
  notes      String      @default("")
  payment    String
  subtotal   Int
  shipping   Int
  total      Int
  createdAt  DateTime    @default(now())
  items      OrderItem[]
}

model OrderItem {
  id        String @id @default(cuid())
  orderId   String
  order     Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  slug      String
  name      String
  quantity  Int
  unitPrice Int
}
